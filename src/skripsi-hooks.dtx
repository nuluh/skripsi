% \subsection{Title Page Hooks}
% The class provides hooks to customize the title page layout and content.
% \subsubsection{Submission Statement}
% \begin{macro}{submissionstatement}
% Users can redefine the submission statement on the title page by redefining the macro |\@skripsi@maketitle@submissionstatement|.
%    \begin{macrocode}
\newcommand{\@skripsi@maketitle@submissionstatement}{Diajukan guna melengkapi persyaratan untuk memenuhi gelar Sarjana di \theprogram, \thefaculty, \theuniversity}
\newcommand{\submissionstatement}[1]{%
  \renewcommand{\gdef\@skripsi@maketitle@submissionstatement}{#1}%
}
\newcommand{\thesubmissionstatement}{\@skripsi@maketitle@submissionstatement}
%    \end{macrocode}
%    \end{macro}
% \subsection{Book Matter Hooks}
% The class provides hooks to customize the |\frontmatter|, |\mainmatter|, and |\backmatter| sections of the document.
% \subsubsection{Page Numbering}
%    \begin{macrocode}
\newcommand{\skripsi@frontmatter@pagenumbering}{\pagenumbering{roman}}
\newcommand{\skripsi@mainmatter@pagenumbering}{\pagenumbering{arabic}}
\newcommand{\skripsi@backmatter@pagenumbering}{\pagenumbering{roman}}
%    \end{macrocode}
% \subsubsection{Page Style}
%    \begin{macrocode}
\newcommand{\skripsi@frontmatter@pagestyle}{\pagestyle{fancyplain}}
\newcommand{\skripsi@mainmatter@pagestyle}{\pagestyle{fancyplain}}
\newcommand{\skripsi@backmatter@pagestyle}{\pagestyle{fancyplain}}
%    \end{macrocode}
% \subsection{Paragraph Indentation}
% \begin{macro}{\SetSectionIndent}
% \begin{macro}{\SetSubsectionIndent}
% \begin{macro}{\SetSubsubsectionIndent}
% User commands to set individual indent levels.
%    \begin{macrocode}
\newcommand{\SetSectionIndent}[1]{%
  \setlength{\skripsi@section@indent}{#1}%
}
\newcommand{\SetSubsectionIndent}[1]{%
  \setlength{\skripsi@subsection@indent}{#1}%
}
\newcommand{\SetSubsubsectionIndent}[1]{%
  \setlength{\skripsi@subsubsection@indent}{#1}%
}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
%    \begin{macrocode}
\makeatother
