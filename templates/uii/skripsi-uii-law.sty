\ProvidesPackage{skripsi-uii-law}[2025/01/01 v1.0 Universitas Islam Indonesia Undergraduate Thesis Style]

\makeatletter
%---------------------------------------
% LOAD BASE COMPONENTS
%---------------------------------------
% Ensure skripsi class is loaded
\@ifclassloaded{skripsi}{}{%
  \PackageError{skripsi-uii-law}{%
    This package requires 'skripsi.cls' document class%
  }{%
    Use: \protect\documentclass{skripsi}%
  }%
}

%---------------------------------------
% METADATA
%---------------------------------------

\program{Ilmu Hukum}
\faculty{Fakultas Hukum}
\university{Universitas Islam Indonesia}
\city{Yogyakarta}
\yearofsubmission{\the\year}

%---------------------------------------
% PAGE GEOMETRY
%---------------------------------------

\RequirePackage{geometry}
\geometry{
  a4paper,
  top=3cm,
  bottom=3cm,
  left=4cm,
  right=3cm
}

% hypersetup
%---------------------------------------
% HYPERREF SETUP
%---------------------------------------
\RequirePackage{hyperref}
\hypersetup{
  bookmarksopen=true,
  bookmarksnumbered=true,
}
%---------------------------------------
% FONTS SIZE
%---------------------------------------
\newcommand\llarge{\@setfontsize\llarge{16}{19.2}}

%---------------------------------------
% PAGE STYLE
%---------------------------------------
\fancypagestyle{plain}{ % for chapter starting pages
    \fancyhf{}
    % \setlength{\headheight}{15pt} % to avoid fancyhdr warning
    \renewcommand{\headrulewidth}{0pt}
    \fancyfoot[R]{\thepage}
}
\fancypagestyle{bottomrightcorner}{
    \fancyhf{}
    % \setlength{\headheight}{15pt} % to avoid fancyhdr warning
    \renewcommand{\headrulewidth}{0pt}
    \fancyfoot[R]{\thepage}
}

%---------------------------------------
% BOOK MATTER FORMATTING
%---------------------------------------
\renewcommand{\skripsi@mainmatter@pagestyle}{\pagestyle{bottomrightcorner}}

%---------------------------------------
% ABSTRACT FORMATTING
%---------------------------------------
\renewcommand{\maxabstractlengthwarning}{200}
\addto\captionsmalay{%
  \renewcommand\abstractname{Abstrak}%
}

%---------------------------------------
% CHAPTER & SECTION TITLING FORMATTING
%---------------------------------------
% Define indent amounts (ABSOLUTE from left margin)

\titleformat{\chapter}[block]
  {\large\bfseries\centering}
  {\MakeUppercase\chaptername~\arabic{chapter}} % << display format
  {1ex}
  {\MakeUppercase}

\titlespacing{\chapter}{0pt}{0cm}{\baselineskip}

\renewcommand{\thesection}{\Alph{section}.}
\renewcommand{\thesubsection}{\arabic{subsection}.}
\renewcommand{\thesubsubsection}{\alph{subsubsection}.}

\SetSubsectionIndent{2em}
\SetSubsubsectionIndent{4em}

\titlespacing*{\section}
  {0pt}       % left indent for heading
  {3.5ex plus 1ex minus .2ex}
  {2.3ex plus .2ex}
\titlespacing*{\subsection}
  {2em}    % left indent for heading
  {3.25ex plus 1ex minus .2ex}
  {1.5ex plus .2ex}
\titlespacing*{\subsubsection}
  {4em}  % left indent for heading
  {3.25ex plus 1ex minus .2ex}
  {1.5ex plus .2ex}

%---------------------------------------
% TABLE OF CONTENTS FORMATTING
%---------------------------------------
\renewcommand{\thechapter}{\arabic{chapter}}
\setlength{\cftsecindent}{1em}
\setcounter{tocdepth}{2}
\makeatother
%---------------------------------------
% TITLE PAGE
%---------------------------------------
\makeatletter
\renewcommand{\maketitle}{%
\ifdefined\thetitle\else \ClassError{skripsi.cls}{Missing \protect\title}{}\fi
\ifdefined\theauthor\else \ClassError{skripsi.cls}{Missing \protect\author}{}\fi
\ifdefined\thedate\else \ClassError{skripsi.cls}{Missing \protect\date}{}\fi
\@check{program}
\@check{faculty}
\@check{university}
\@check{yearofsubmission}
  {%
    \begin{titlepage}
    \onehalfspacing
    \newgeometry{margin=3cm}%
    \noindent
    \begin{minipage}[t][0.49\textheight][t]{\textwidth}
    \centering
    {\fontsize{14pt}{16pt}\selectfont \textbf{\MakeUppercase{\thetitle}}\par}
    \vspace{1.5cm}
    {\fontsize{14pt}{16pt}\selectfont \textbf{\MakeUppercase{Skripsi}}\par}
    \vfill
    \end{minipage}
    \begin{tikzpicture}[remember picture, overlay]
        % This respects your geometry margins
        \coordinate (center) at (current page text area.center);

        % The logo at center of page (ANCHOR POINT) shift up by 1cm
        \node at ($(center) + (0cm,1cm)$)
        {\includesvg[width=3cm]{frontmatter/img/logo.svg}};
    \end{tikzpicture}%
    \begin{minipage}[b][0.49\textheight][b]{\textwidth}
    \centering

    \vfill
    
    Oleh: \par
    \begin{tabular}{ll}
    Nama & : \theauthor \\
    No. Mhs & : \theauthorid \\
    Program Studi & : \theprogram \\
    \end{tabular}

    \vfill

    {\llarge
    \textbf{\MakeUppercase\theuniversity} \par
    \textbf{\MakeUppercase\thefaculty} \par
    \textbf{\MakeUppercase\thecity} \par
    \textbf{\theyearofsubmission} \par
    }
    \end{minipage}
    \end{titlepage}%
  }%
}
\makeatother
