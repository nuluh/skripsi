\RequirePackage[style=ieee, backend=biber]{biblatex}
\ExecuteBibliographyOptions{
    alltimes=24h,
    datezeros=false,
    dateera=secular,
    dateeraauto=600,
    dateuncertain=true,
    datecirca=true,
    sorting=none,
    url=false,
    doi=false,
    isbn=false
}
